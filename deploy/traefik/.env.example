# Copy to .env next to docker-compose.yml and fill in. Keep .env out of version control.

# Where the gateway serves apps, one of:
#   *.example.com       every subdomain, each app on its own (app1.example.com, ...); wildcard certificate
#   webhop.example.com  this one host name only
# The domain's other names, the bare domain included, stay free for other uses.
WEBHOP_HOST=*.example.com

# Optional contact address for the Let's Encrypt account. Let's Encrypt doesn't store it or send
# expiry notices (Traefik renews on its own); it may add it to its general mailing list.
# ACME_EMAIL=admin@example.com

# The public key set, whk_…, that `webhop issuer init <WEBHOP_HOST>` prints
WEBHOP_KEYSET=

# Your DNS host's code and its credentials, named as on its page at https://go-acme.github.io/lego/dns/
# Needed for *.example.com. For one host name, leave these out: Let's Encrypt then checks the name
# by connecting to it on port 443.
DNS_PROVIDER=porkbun
PORKBUN_API_KEY=pk1_xxxxxxxx
PORKBUN_SECRET_API_KEY=sk1_xxxxxxxx

# Another host, for example:
# DNS_PROVIDER=cloudflare
# CF_DNS_API_TOKEN=xxxxxxxx

# Traefik takes ports 80 and 443 itself. Uncomment instead when nginx or another web server owns
# them and passes the TLS connections for WEBHOP_HOST through to 127.0.0.1:8443 (see README).
# Run docker compose down before switching either way.
# COMPOSE_FILE=docker-compose.yml:behind-proxy.yml

# Uncomment to try the setup on Let's Encrypt's staging CA (higher limits, not trusted by browsers).
# Any value turns it on, even false: delete or comment out the line to get real certificates.
# ACME_STAGING=true

# Optional: another gateway image or tag
# WEBHOP_IMAGE=elebree/webhop:2.1.0
